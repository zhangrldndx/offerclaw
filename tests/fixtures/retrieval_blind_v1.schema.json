{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offerclaw.local/schemas/retrieval-blind-v1.json",
  "title": "OfferClaw private retrieval blind set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": {"const": "retrieval_blind_v1"},
    "items": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "origin", "relevant_targets"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "origin": {"enum": ["real_user", "independent_author"]},
          "relevant_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "chunk_id", "answer_span_hash", "relevance"],
              "properties": {
                "source": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
                "chunk_id": {"type": "string", "minLength": 1},
                "answer_span_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "relevance": {"enum": ["direct", "supporting"]}
              }
            }
          }
        }
      }
    }
  }
}
