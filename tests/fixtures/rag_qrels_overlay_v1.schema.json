{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offerclaw.local/schemas/rag-qrels-overlay-v1.json",
  "title": "OfferClaw retrieval qrels overlay v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewer_id", "base_set", "index", "items"],
  "properties": {
    "schema_version": {"const": "rag-qrels-overlay-v1"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "base_set": {"const": "tests/rag_bench_paraphrase_set.json"},
    "review_method": {"type": "string"},
    "index": {
      "type": "object",
      "required": ["collection", "count"],
      "properties": {
        "collection": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0},
        "fingerprint": {"type": "string"}
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "review_outcome", "review_note", "relevant_targets"],
        "allOf": [
          {
            "if": {"properties": {"review_outcome": {"const": "unsupported"}}, "required": ["review_outcome"]},
            "then": {"properties": {"relevant_targets": {"maxItems": 0}}},
            "else": {"properties": {"relevant_targets": {"minItems": 1}}}
          }
        ],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "review_outcome": {"enum": ["accepted", "partial", "unsupported"]},
          "review_note": {"type": "string", "minLength": 1},
          "relevant_targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "heading_path", "chunk_id", "answer_span_hash", "evidence_excerpt", "relevance", "review_note"],
              "properties": {
                "source": {"type": "string", "pattern": "^[^/\\\\]+\\.md$"},
                "heading_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "chunk_id": {"type": "string", "minLength": 1},
                "answer_span_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "evidence_excerpt": {"type": "string", "minLength": 1},
                "relevance": {"enum": ["direct", "supporting"]},
                "review_note": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
