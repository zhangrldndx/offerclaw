# Synthetic OfferClaw lab configuration. The API key is injected by OpenClaw SecretRef.
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gpt-5.6-terra
RAG_SYNTH_MODEL=gpt-5.6-terra
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DIMENSIONS=768
OFFERCLAW_TORCH_DEVICE=cpu
# Keep the WSL lab lightweight; production keeps the repository's default reranker.
RAG_RERANK=0
