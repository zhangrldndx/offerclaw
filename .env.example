# OfferClaw local API configuration.
# Copy this file to .env.local and fill keys locally. Never commit .env.local.

# -----------------------------------------------------
# Chat / Agent / resume / planning LLM
# -----------------------------------------------------
# Loopback-only OpenAI-compatible development service:
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gpt-5.6-terra
RAG_SYNTH_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT=60

# ---- 顶部统一只读助手的意图路由 ----
# 自然语言固定执行语义 v3 规划；留空继承 GPT 主模型。
RAG_ROUTE_MODEL=
RAG_ROUTE_TIMEOUT_SECONDS=60
RAG_ROUTE_REASONING_EFFORT=low
RAG_ROUTE_MAX_TOKENS=600
# GPT 规划失败时默认澄清；原型排序只用于离线评测。
JD_ANALYZER_MODE=shadow
JD_ANALYSIS_MODEL=
JD_ANALYSIS_TIMEOUT_SECONDS=30
JD_ANALYSIS_REASONING_EFFORT=low
# ---- 岗位要求与个人证据的语义对齐 ----
# /ui 默认启用；旧 API 客户端可通过 use_semantic=false 保持纯规则模式。
# 该调用只返回 requirement_id → evidence_id，不拥有硬门槛或三档裁决权。
MATCH_SEMANTIC_MODEL=
MATCH_SEMANTIC_TIMEOUT_SECONDS=30
MATCH_SEMANTIC_REASONING_EFFORT=low
# GPT provider 通过能力探针后使用 JSON Object mode；不支持时只允许 shadow
# 显式改为 prompt_only，不得静默切到其他模型。
STRUCTURED_LLM_RESPONSE_FORMAT=json_object
# unknown 时在线调用 fail-closed，shadow 使用 prompt-only；运行下列命令显式探测并缓存：
# python scripts/probe_structured_llm.py --execute
STRUCTURED_LLM_JSON_CAPABILITY=unknown
STRUCTURED_LLM_REASONING_EFFORT=low
STRUCTURED_LLM_USE_FALLBACK_ENDPOINT=0
# 在线与 shadow 使用隔离的有界执行器；首次调用与 repair 共享总 deadline。
STRUCTURED_LLM_ONLINE_WORKERS=2
STRUCTURED_LLM_ONLINE_QUEUE=4
STRUCTURED_LLM_SHADOW_WORKERS=1
STRUCTURED_LLM_SHADOW_QUEUE=2
STRUCTURED_LLM_QUEUE_TIMEOUT_SECONDS=0.1
STRUCTURED_LLM_REPAIR_MIN_REMAINING_SECONDS=1.5
# 下列开关仅供旧 hybrid 路由兼容周期使用。
RAG_SCOPED_LLM_PLANNER=1
RAG_PLANNER_TIMEOUT_SECONDS=5
# 阈值默认读取 config/rag_routing_profile.json；仅在压测/标定时覆盖。
# RAG_ROUTE_ACCEPT_SCORE=0.70
# RAG_ROUTE_MARGIN=0.08
# RAG_ROUTE_CONFLICT_MARGIN=0.10

# ---- 额度兜底（可选）：主模型在额度/鉴权/限流/网络类失败后自动改发兜底模型 ----
# 默认严格关闭；即使下列三变量存在，也只有显式设为 1 才可能发起兜底请求。
LLM_FALLBACK_ENABLED=0
# 启用后仍须三变量齐全；额度类硬错误（欠费/免费档耗尽/401/402）切换；
# 参数类 4xx（模型名打错等）不兜底，直接报错暴露。实现见 day1_api_starter.chat_completion。
# LLM_FALLBACK_API_KEY=your_deepseek_api_key
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com
# LLM_FALLBACK_MODEL=deepseek-chat

# ---- 换用其他国内常见模型（协议均为 OpenAI 兼容，替换上面 4 个变量即可）----
# 推荐方式：把各家配置存成下面的「命名组」，然后用切换脚本一键换激活组
# （只改激活三变量 + RAG_SYNTH_MODEL，embedding/知识库不动）：
#   python scripts/switch_llm_provider.py --list
#   python scripts/switch_llm_provider.py --provider deepseek   # 或 gpt / bailian
#
# DeepSeek 命名组（platform.deepseek.com）：
# DEEPSEEK_API_KEY=your_deepseek_api_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
#
# OpenAI 兼容代理命名组（自备中转，默认 gpt-5.6-terra）：
# GPT_PROXY_API_KEY=your_proxy_key
# GPT_PROXY_BASE_URL=https://your-proxy.example.com/v1
# GPT_PROXY_MODEL=gpt-5.6-terra
#
# 也可以不走脚本、手工替换三变量，例如 DeepSeek：
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# RAG_SYNTH_MODEL=deepseek-chat
#
# 智谱 GLM（bigmodel.cn；本项目已适配其鉴权差异）：
# OPENAI_API_KEY=your_zhipu_api_key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus          # 以智谱官网当前模型名为准
# RAG_SYNTH_MODEL=glm-4-plus
#
# 注意：换"生成"模型不影响已建好的知识库；只有 embedding（下节）和知识库绑定。
# DeepSeek 不提供 embedding —— 没有百炼/智谱 key 时，embedding 选 local（免费，见下文）。

# -----------------------------------------------------
# RAG embedding provider
# -----------------------------------------------------
# Bailian text embedding. Keep this collection separate from old Zhipu vectors.
EMBEDDING_PROVIDER=bailian
DASHSCOPE_API_KEY=your_dashscope_api_key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RAG_COLLECTION_NAME=offerclaw_bailian_text_embedding_v4_1024

# -----------------------------------------------------
# Production retrieval profile (offline/shadow gate before switching)
# -----------------------------------------------------
# baseline remains the default. candidate_shadow serves baseline synchronously;
# its separately resolved candidate arm is reserved for an isolated shadow job.
# Shadow uses one daemon worker and a two-job queue. On local MPS it shares the
# reranker inference lock and can consume background capacity, so enable it only
# during an explicit observation window. Logs contain hashes/IDs, never queries.
RAG_RETRIEVAL_PROFILE=baseline
# RAG_CANDIDATE_SHADOW_LOG=.offerclaw/rag_candidate_shadow.jsonl
RAG_RECALL_N=20
# Baseline accepts legacy RAG_RERANK_MODEL/RAG_RERANK_POOL when these are blank.
# RAG_BASELINE_RERANK_MODEL=BAAI/bge-reranker-base
# RAG_BASELINE_RERANK_POOL=20
# RAG_BASELINE_RERANK_BREADCRUMB=0
# Candidate settings never mutate the rollback baseline.
# RAG_CANDIDATE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RAG_CANDIDATE_RERANK_POOL=10
# RAG_CANDIDATE_RERANK_BREADCRUMB=0
# Legacy baseline compatibility knobs:
# RAG_RERANK_POOL=20
# RAG_RERANK_MODEL=BAAI/bge-reranker-base

# ---- 显式论文/英文资料的范围化跨语言增强 ----
# 只在 QueryPlan 明确选择 paper_kb 时生效；普通知识库、个人记忆和状态查询
# 不会加载英文桥，也不会增加候选或延迟。baseline 是一键回滚终点。
RAG_PAPER_PROFILE=baseline
# 达到本地 50 题端到端门禁后，可改为 paper_quality：
# RAG_PAPER_PROFILE=paper_quality
# RAG_RERANK_EN_ONNX_DIR=~/.cache/modelscope/hub/models/cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RAG_EN_GATE_MIN=0.80

# ---- Answerability 本地学生重排（默认严格关闭）----
# 新统一模式：off / student / balanced / teacher。缺省或非法值一律 off。
# 兼容旧 RAG_ANSWERABILITY=1（等价 teacher），但新部署应只设置 MODE。
RAG_ANSWERABILITY_MODE=off
# RAG_ANSWERABILITY_STUDENT_MODEL=/absolute/path/to/approved/student_model
# RAG_ANSWERABILITY_BALANCED_POLICY=/absolute/path/to/frozen_balanced_policy.json
# 仅本地开发检查可加载 development checkpoint；生产不得打开：
# RAG_ANSWERABILITY_STUDENT_ALLOW_DEVELOPMENT=0
# 本地学生加载失败会原样保留现有 BGE 顺序，不会自动调用昂贵 teacher。
# RAG_ANSWERABILITY_DEPTH=6
# RAG_ANSWERABILITY_EARLY_EXIT=0
# teacher 模式/teacher fallback 使用的模型：
# RAG_ANSWERABILITY_MODEL=gpt-5.6-terra

# ---- 证据门：结构块（文档标题块 / 页面结构目录）不作为判据 ----
# 目录块与问题词面高度重合，向量距离近、精排分高，但不含任何可作答的断言——
# v2aneg-015 就是被一块 167 字的标题块以 dist 0.576 / rerank 0.9712 放行的。
# 打开后，门改用「名次最靠前的实心块」当判据；排序与召回不变，
# 候选池全是结构块时退回原行为（"这份文档都讲了什么"仍答得出来）。
# 取值 = 一块最多能有多少比例的字符是「没有正文的标题」，0.32 是实测间隙中点
# （金标块最大 0.250 / 误纳目录块 0.391）。默认空 = 关；上默认前须过 Final 集。
# RAG_STRUCTURAL_EVIDENCE_MAX=0.32

# ---- Answerability 裁判的 record-only shadow（默认严格关闭）----
# 仅 reference_kb 生产路由会被观察；个人经历、项目记忆、简历规则不会进入该流。
# 未完成 agent 候选发现 + 全新 organic blind 窗口前，不设置触发阈值、不接答案链路。
RAG_SHADOW_ANSWERABILITY=0
# 默认缺省仍是旧的 trigger+control 行为。Window A/B 才显式设置 accepted_control：
# RAG_SHADOW_SAMPLING_MODE=accepted_control
# RAG_SHADOW_WINDOW_ID=organic_window_a_YYYYMMDD
# RAG_SHADOW_WINDOW_PHASE=calibration_a
# RAG_SHADOW_PROTOCOL_ID=answerability-organic-v4
# RAG_SHADOW_PROTOCOL_SHA256=<冻结协议文件的 64 位 SHA256>
# RAG_SHADOW_GATE_REJECT_CONTROL_RATE=0.05
# Window B 另需冻结规则谱系；缺任一项会 fail-closed，只记特征、不请裁判：
# RAG_SHADOW_FROZEN_RULE_ID=<Window A 按预注册算法选出的规则 ID>
# RAG_SHADOW_FROZEN_RULE_SHA256=<冻结规则文件的 64 位 SHA256>
# 可选：显式指定窗口日志；缺省按 WINDOW_ID 隔离到 logs/rag_eval/...：
# RAG_SHADOW_LOG_PATH=
# 以下三项只服务旧 trigger+control 兼容模式：
# RAG_SHADOW_CONTROL_RATE=0.05
# RAG_SHADOW_TRIGGER_MARGIN=
# RAG_SHADOW_TRIGGER_HIGH_SCORE=
# 离线流量 Agent 使用见：
# docs/rag_eval/answerability_shadow/SHADOW_TRAFFIC_AGENT_GUIDE.md

# -----------------------------------------------------
# Legacy Zhipu fallback
# -----------------------------------------------------
# EMBEDDING_PROVIDER=zhipu
# ZHIPU_API_KEY=your_key_id.your_signing_secret
# EMBEDDING_MODEL=embedding-3
# RAG_COLLECTION_NAME=offerclaw_docs

# -----------------------------------------------------
# 本地 embedding（推荐，永久免费、无额度、稳定）
# -----------------------------------------------------
# 装依赖：pip install sentence-transformers modelscope
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5     # 或 BAAI/bge-m3（更强但 2.3GB）
# EMBEDDING_DIMENSIONS=768                   # bge-m3 用 1024
# RAG_COLLECTION_NAME=offerclaw_local_bge_base_zh_768
# 国内下载慢时可设 HF 镜像（或用 modelscope，本项目已优先 modelscope）：
# HF_ENDPOINT=https://hf-mirror.com

# -----------------------------------------------------
# 图转文（让图片/图片版公式可被 RAG 检索）
# -----------------------------------------------------
# IMAGE_CAPTION=1            # 开启后 ingest 时用视觉模型把图片转成"描述+OCR"
# VL_MODEL=qwen-vl-plus      # 视觉模型（端点独立于主链路 LLM——主链路切 GPT/DeepSeek 不影响图转文）
# VL_BASE_URL=               # 可选覆盖视觉端点（默认 dashscope compatible-mode）
# VL_API_KEY=                # 可选覆盖视觉 key（默认用 DASHSCOPE_API_KEY）
# 注：DeepSeek 无视觉 API；经代理的 GPT 对图像输入实测会幻觉作答（接受请求但看不到图），
# 故图转文保持百炼 qwen-vl-plus。
